# 複製成 .env 再改。全部都可以不填，不填就是括號裡的預設。

# ── 對外 ──
# 本機 port（8510）
PORT=8510
# 整站登入（HTTP Basic）。有任何非本機的人連得到就一定要設；空白 = 不鎖
AUTH_USER=admin
AUTH_PASSWORD=

# ── 價格提醒（內建，背景每 ALERT_INTERVAL 秒查價，觸發一次就停用）──
ALERT_INTERVAL=15
# Telegram：跟 @BotFather 建 bot 拿 token；chat id 可以先私訊 bot 再開 https://api.telegram.org/bot<token>/getUpdates 看
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 任意 webhook（Slack / Discord incoming webhook 或自己的服務），POST JSON
ALERT_WEBHOOK_URL=

# ── 商品 logo ──
# favicon（公司官網圖示）/ tradingview（非官方介面，可能違反其使用條款，自行判斷）/ none
LOGO_SOURCE=favicon
